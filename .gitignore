# Git 忽略文件
# Yuruicamp 專案

# 本地 ECPay skill（獨立 git repo，勿嵌進主專案）
# Local ECPay skill (separate git repo — do not embed in main project)
.ecpay-skill/

# Claude Code 本機 skills／設定（.claude/skills/ecpay 內含自己的 .git，屬獨立 repo，勿嵌進主專案）
# Claude Code local skills/config (.claude/skills/ecpay has its own .git — separate repo, do not embed)
.claude/

# Matt Pocock / skills.sh 本機 skills（勿 commit）
# Keep project-owned skills tracked; ignore everything else under .agents/skills/
.agents/skills/*/
!.agents/skills/frontend-design/
!.agents/skills/frontend-spec/
!.agents/skills/pre-review-checklist/
!.agents/skills/ui-ux-pro-max/
skills-lock.json

# Matt Pocock local setup（本機票／agents 設定，不上 GitHub）
# Local issue tracker + agents config — keep out of git
.scratch/
docs/agents/

# 依賴相關（前端依賴安裝於 frontend/）
node_modules/
.pnpm-store/
yarn.lock

# IDE 相關
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 構建輸出
dist/
build/
.cache/
.vite/

# Firebase Hosting assemble output + CLI junk
deploy/staging/hosting-out/
frontend/dist-firebase-app/
# Generated by frontend/scripts/write-yurui-env.mjs (dev/build); do not commit Staging URLs.
frontend/public/yurui-env.js
.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log

# 日誌文件
*.log
logs/

# 環境變量（保留 .env.example 給組員當範本；真密碼只放 .env）
.env
.env.local
.env.*.local

# 臨時文件
*.tmp
temp/

# 壓縮文件
*.zip
*.rar
*.7z

# 編譯產物
*.css（若使用自動編譯 SCSS）
# 保留 main.css 用於生產環境（路徑相對 frontend/）
!frontend/css/main.css

# 影片檔案（超過 GitHub 100MB 限制，請放本機／CDN，勿 commit）
# Video assets exceed GitHub's 100MB limit — keep local / CDN, do not commit
frontend/assets/videos/
*.mp4
YuruicampTest/

# CLI 腳本：預設忽略 scripts/，只放行前端驗證／同步用腳本
scripts/
