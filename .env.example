# 複製成 .env 後再改密碼（.env 不要 commit）
# Copy to .env, then change the password (.env must NOT be committed)
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=請改成你的本機開發密碼
POSTGRES_DB=yuruicamp
POSTGRES_PORT=5433

# Spring Boot（backend/）可選覆寫；預設連 localhost:5433
# DB_URL=jdbc:postgresql://localhost:5433/yuruicamp
# DB_USERNAME=postgres
# DB_PASSWORD=（與上面 POSTGRES_PASSWORD 相同）

# Firebase：預設 false 時使用 dev: stub token（見 backend/README.md）
# FIREBASE_ENABLED=false
# FIREBASE_CREDENTIALS=C:\path\to\firebase-service-account.json
# FIREBASE_PROJECT_ID=yuruicamp-2026

# ---------------------------------------------------------------------------
# ECPay 綠界（backend/ spring-boot:run 前設定；勿 commit 真實 HashKey）
# 本機 stub（預設）：YURUICAMP_ECPAY_STUB=true → 假付款頁，不需 ngrok
# 真實沙箱：YURUICAMP_ECPAY_STUB=false + YURUICAMP_ECPAY_LOGISTICS_STUB=false + ngrok
# 見 docs/backend-specs/logistics/ecpay-real-sandbox-validation.md
# ---------------------------------------------------------------------------
# YURUICAMP_ECPAY_STUB=true
# YURUICAMP_ECPAY_MERCHANT_ID=3002607
# YURUICAMP_ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
# YURUICAMP_ECPAY_HASH_IV=EkRm7iFT261dpevs
# YURUICAMP_ECPAY_PAYMENT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
# 本機 stub 預設；ngrok 時改為 https://你的子網域.ngrok-free.app/api
# YURUICAMP_ECPAY_PUBLIC_API_BASE_URL=http://localhost:8080/api
# YURUICAMP_FRONTEND_BASE_URL=http://127.0.0.1:5173

# ECPay 國內物流 CVS（MerchantID 2000132，MD5；與金流帳號不同）
# 本機 stub（預設）：YURUICAMP_ECPAY_LOGISTICS_STUB=true
# 真實沙箱：false + 同上 PUBLIC_API_BASE_URL（ngrok）→ docs/backend-specs/logistics/ecpay-real-sandbox-validation.md
# YURUICAMP_ECPAY_LOGISTICS_STUB=true
# YURUICAMP_ECPAY_LOGISTICS_MERCHANT_ID=2000132
# YURUICAMP_ECPAY_LOGISTICS_HASH_KEY=5294y06JbISpM5x9
# YURUICAMP_ECPAY_LOGISTICS_HASH_IV=v77hoKGq4kWxNNIS
# YURUICAMP_ECPAY_LOGISTICS_SUB_TYPE=FAMI
# YURUICAMP_ECPAY_LOGISTICS_HOME_SUB_TYPE=TCAT
